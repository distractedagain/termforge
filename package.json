{
  "name": "termforge",
  "productName": "TermForge",
  "version": "0.7.0",
  "description": "An independent open-source terminal, SSH session manager, and automation client",
  "main": "app/main.cjs",
  "license": "MIT",
  "author": "TermForge contributors",
  "homepage": "https://github.com/distractedagain/termforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/distractedagain/termforge.git"
  },
  "bugs": {
    "url": "https://github.com/distractedagain/termforge/issues"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && node scripts/ui-check.cjs",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-pty-permissions.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "playwright": "^1.64.0",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "org.termforge.desktop",
    "productName": "TermForge",
    "icon": "build/icon.png",
    "beforePack": "scripts/package-licenses.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "!app/**/__pycache__/**",
      "!app/**/*.pyc",
      "renderer/index.html",
      "renderer/dist/**/*",
      "LICENSE",
      "README.md",
      "docs/**/*",
      "SECURITY.md",
      "third-party-licenses/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@serialport/bindings-cpp/**/*"
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "TermForge contributors"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
