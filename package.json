{
  "name": "harbor-terminal",
  "productName": "Harbor Terminal",
  "version": "0.2.0",
  "description": "An independent open-source desktop terminal and SSH session manager",
  "main": "app/main.cjs",
  "license": "MIT",
  "author": "Harbor Terminal contributors",
  "homepage": "https://github.com/distractedagain/harbor-terminal",
  "repository": { "type": "git", "url": "https://github.com/distractedagain/harbor-terminal.git" },
  "bugs": { "url": "https://github.com/distractedagain/harbor-terminal/issues" },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-pty-permissions.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "org.harbor-terminal.desktop",
    "productName": "Harbor Terminal",
    "icon": "build/icon.png",
    "beforePack": "scripts/package-licenses.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "renderer/index.html",
      "renderer/dist/**/*",
      "LICENSE",
      "README.md",
      "docs/**/*",
      "SECURITY.md",
      "third-party-licenses/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Harbor Terminal contributors"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
