{
  "name": "termforge",
  "productName": "ForgeCRT",
  "version": "0.16.0",
  "description": "An independent open-source terminal, SSH session manager, and automation client",
  "main": "app/main.cjs",
  "license": "MIT",
  "author": "ForgeCRT contributors",
  "homepage": "https://github.com/distractedagain/termforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/distractedagain/termforge.git"
  },
  "bugs": {
    "url": "https://github.com/distractedagain/termforge/issues"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && node scripts/ui-check.cjs",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-pty-permissions.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test:projects": "npm run build && node scripts/project-ui-check.cjs",
    "test:ansible": "node scripts/ansible-check.cjs",
    "test:secure-ui": "npm run build && node scripts/secure-ui-check.cjs",
    "test:quick-connect": "npm run build && node scripts/quick-connect-ui-check.cjs",
    "test:menus": "npm run build && node scripts/menu-ui-check.cjs",
    "test:key-tools-ui": "node scripts/key-tools-ui-check.cjs",
    "test:session-import-ui": "node scripts/session-import-ui-check.cjs",
    "test:remote-files-ui": "node scripts/remote-files-ui-check.cjs",
    "test:folder-transfers-ui": "node scripts/folder-transfer-ui-check.cjs",
    "test:transfer-workflows-ui": "node scripts/transfer-workflows-ui-check.cjs",
    "test:advanced-transfers-ui": "node scripts/advanced-transfers-ui-check.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "6.2.3",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "playwright": "^1.64.0"
  },
  "build": {
    "appId": "org.termforge.desktop",
    "productName": "ForgeCRT",
    "icon": "build/icon.png",
    "beforePack": "scripts/package-licenses.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "!app/**/__pycache__/**",
      "!app/**/*.pyc",
      "renderer/index.html",
      "renderer/quick-connect.html",
      "renderer/dist/**/*",
      "LICENSE",
      "README.md",
      "docs/**/*",
      "SECURITY.md",
      "third-party-licenses/**/*",
      "package.json",
      "examples/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@serialport/bindings-cpp/**/*"
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "ForgeCRT contributors",
      "executableName": "termforge"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "dompurify": "3.4.17"
  },
  "desktopName": "termforge.desktop"
}
